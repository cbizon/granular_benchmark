{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "submission_manifest", "cases_complete", "limitations"],
  "properties": {
    "status": {
      "enum": ["complete", "partial", "failed"]
    },
    "submission_manifest": {
      "type": "string"
    },
    "cases_complete": {
      "type": "array",
      "items": {
        "enum": ["a", "b", "cd", "e", "f", "g", "h"]
      },
      "uniqueItems": true
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
